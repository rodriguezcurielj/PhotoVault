<Window x:Class="Gallery.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gallery" Width="880" Height="680" MinWidth="640" MinHeight="560"
        Background="#F5F5F7" Foreground="#1D1D1F" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14" WindowStartupLocation="CenterScreen" Icon="pack://application:,,,/gallery.ico">
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo x:Name="Taskbar"/>
    </Window.TaskbarItemInfo>
    <Grid>
        <!-- ============ Sign in ============ -->
        <Grid x:Name="LoginView">
            <StackPanel Width="340" VerticalAlignment="Center">
                <Image Source="gallery.png" Width="88" Height="88"/>
                <TextBlock Text="Gallery" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,14,0,2"/>
                <TextBlock Text="Sign in to upload from this PC." Foreground="{StaticResource Muted}" FontSize="15" HorizontalAlignment="Center" Margin="0,0,0,22"/>
                <TextBlock Text="Username" Foreground="{StaticResource Muted}" FontSize="12" Margin="2,0,0,4"/>
                <TextBox x:Name="UserBox" Style="{StaticResource Field}" Margin="0,0,0,10"/>
                <TextBlock Text="Password" Foreground="{StaticResource Muted}" FontSize="12" Margin="2,0,0,4"/>
                <PasswordBox x:Name="PwBox" Style="{StaticResource PwField}" Margin="0,0,0,14" KeyDown="Pw_KeyDown"/>
                <Button x:Name="SignInBtn" Content="Sign In" Style="{StaticResource Primary}" Padding="0,12" FontSize="15" Click="SignIn_Click"/>
                <TextBlock x:Name="LoginError" Foreground="{StaticResource Danger}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,12,0,0"/>
                <TextBlock Text="Server" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,26,0,4"/>
                <TextBox x:Name="ServerBox" Style="{StaticResource Field}" FontSize="13"/>
            </StackPanel>
        </Grid>

        <!-- ============ Upload ============ -->
        <DockPanel x:Name="MainView" Visibility="Collapsed">
            <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="18,10">
                <DockPanel>
                    <Image Source="gallery.png" Width="30" Height="30"/>
                    <TextBlock Text="Gallery" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                        <TextBlock x:Name="AccountText" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Button Content="Open Gallery" Style="{StaticResource Link}" Click="Open_Click"/>
                        <Button Content="Sign Out" Style="{StaticResource Link}" Click="SignOut_Click"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,20" MaxWidth="820">
                    <!-- Drop zone -->
                    <Border x:Name="DropZone" CornerRadius="18" Background="White" Padding="20,30" AllowDrop="True"
                            DragEnter="Drop_DragEnter" DragLeave="Drop_DragLeave" Drop="Drop_Drop">
                        <Border.BorderBrush>
                            <VisualBrush>
                                <VisualBrush.Visual>
                                    <Rectangle x:Name="DashRect" StrokeDashArray="6 4" Stroke="#C7C7CC" StrokeThickness="2" RadiusX="18" RadiusY="18"
                                               Width="{Binding ActualWidth, ElementName=DropZone}" Height="{Binding ActualHeight, ElementName=DropZone}"/>
                                </VisualBrush.Visual>
                            </VisualBrush>
                        </Border.BorderBrush>
                        <Border.BorderThickness>2</Border.BorderThickness>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="&#xE898;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="40" Foreground="{StaticResource Accent}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Drop photos, videos or whole folders here" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,6,0,4"/>
                            <TextBlock Text="Thousands at a time is fine. Ones already in Gallery are skipped." Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                                <Button x:Name="FolderBtn" Content="Choose Folder…" Style="{StaticResource Primary}" Margin="0,0,10,0" Click="ChooseFolder_Click"/>
                                <Button x:Name="FilesBtn" Content="Choose Files…" Style="{StaticResource Btn}" Click="ChooseFiles_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Progress -->
                    <Border x:Name="ProgressCard" Style="{StaticResource Card}" Margin="0,16,0,0" Visibility="Collapsed">
                        <StackPanel>
                            <DockPanel>
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                    <Button x:Name="PauseBtn" Content="Pause" Style="{StaticResource Btn}" Margin="0,0,8,0" Click="Pause_Click"/>
                                    <Button x:Name="CancelBtn" Content="Cancel" Style="{StaticResource Btn}" Foreground="{StaticResource Danger}" Click="Cancel_Click"/>
                                    <Button x:Name="RetryBtn" Content="Retry Failed" Style="{StaticResource Primary}" Margin="8,0,0,0" Visibility="Collapsed" Click="Retry_Click"/>
                                </StackPanel>
                                <TextBlock x:Name="PhaseText" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </DockPanel>
                            <ProgressBar x:Name="Bar" Margin="0,16,0,10" Maximum="1"/>
                            <TextBlock x:Name="CountsText" Foreground="{StaticResource Ink}" TextWrapping="Wrap"/>
                            <TextBlock x:Name="SpeedText" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
                            <ItemsControl x:Name="RecentList" Margin="0,14,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate><TextBlock Text="{Binding}" Foreground="{StaticResource Muted}" FontSize="12.5" TextTrimming="CharacterEllipsis"/></DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Options -->
                    <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="22,14">
                        <DockPanel>
                            <ComboBox x:Name="ParallelBox" DockPanel.Dock="Right" Width="70" SelectionChanged="Parallel_Changed">
                                <ComboBoxItem Content="1"/><ComboBoxItem Content="2"/><ComboBoxItem Content="4"/><ComboBoxItem Content="6"/><ComboBoxItem Content="8"/>
                            </ComboBox>
                            <StackPanel>
                                <TextBlock Text="Uploads at the same time" FontWeight="SemiBold"/>
                                <TextBlock Text="More is faster on fast internet. 4 is a good start." Foreground="{StaticResource Muted}" FontSize="12.5"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <TextBlock Foreground="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap" Margin="4,12,4,0"
                               Text="Photos are placed by the date they were taken. For files without one, the date in a Google Takeout .json file, the date in the file name (like IMG_20230514 or WhatsApp's VID-20230514), or the file's modified date is used. The PC won't go to sleep while uploading."/>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>
