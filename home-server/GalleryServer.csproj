<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- .NET Framework 4.8 is built into Windows 10 and 11, so the exe runs with nothing else installed. -->
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Gallery Server</AssemblyName>
    <RootNamespace>GalleryServer</RootNamespace>
    <ApplicationIcon>..\windows\gallery.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <Product>Gallery Server</Product>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\windows\gallery.ico" LogicalName="gallery.ico" />
    <EmbeddedResource Include="..\windows\gallery.png" LogicalName="gallery.png" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>

</Project>
